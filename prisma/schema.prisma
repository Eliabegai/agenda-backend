generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String              @id @default(uuid())
  nome                 String
  email                String              @unique
  criadoEm             DateTime            @default(now())
  atualizadoEm         DateTime            @updatedAt
  senha                String
  role                 RoleUser            @default(USER)
  passwordResetTokenId String?
  horarios             Horario[]
  agendamentos         Agendamento[]
  indisponibilidades   Indisponibilidade[]
  passwordResetToken   PasswordResetToken?
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String   @unique
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Horario {
  id         String  @id @default(uuid())
  diaSemana  Int // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  startTime  String // Formato HH:mm:ss
  endTime    String // Formato HH:mm:ss
  breakStart String // Formato HH:mm:ss
  breakEnd   String // Formato HH:mm:ss
  User       User?   @relation(fields: [userId], references: [id])
  userId     String?
}

model Agendamento {
  id           String            @id @default(uuid())
  protocolo    Protocolo         @relation(fields: [protocoloId], references: [id])
  protocoloId  String
  dataHora     DateTime
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt
  status       StatusAgendamento @default(AGENDADO)
  User         User?             @relation(fields: [userId], references: [id])
  userId       String?

  @@unique([userId, dataHora]) // Garantindo funcionários diferentes tenham agendamentos no mesmo horário
}

model Cliente {
  id           String      @id @default(uuid())
  nome         String
  telefone     String
  email        String      @unique
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  protocolos   Protocolo[]
}

model Protocolo {
  id           String        @id @default(uuid())
  cliente      Cliente       @relation(fields: [clienteId], references: [id])
  clienteId    String
  codigo       String        @unique
  agendamentos Agendamento[]
}

model Indisponibilidade {
  id         String    @id @default(uuid())
  inicio     String // Formato HH:mm:ss
  fim        String // Formato HH:mm:ss
  dataInicio DateTime? // Opcional, caso queira definir um período específico
  dataFim    DateTime? // Opcional, para definir até quando a regra vale
  motivo     String?
  User       User?     @relation(fields: [userId], references: [id])
  userId     String?
}

model InvalidToken {
  id       String   @id @default(uuid())
  token    String   @unique
  criadoEm DateTime @default(now())
}

enum StatusAgendamento {
  AGENDADO
  CANCELADO
  NAO_COMPARECEU
  ENCERRADO
  EMITIDO
  REAGENDADO
  REAGENDAR
}

enum RoleUser {
  ADMIN
  USER
}
