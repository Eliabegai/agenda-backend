generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id       String   @id @default(uuid())
  nome     String
  email    String   @unique
  senha    String // Hash da senha
  criadoEm DateTime @default(now())
}

model Funcionario {
  id                 String              @id @default(uuid())
  nome               String
  email              String              @unique
  criadoEm           DateTime            @default(now())
  atualizadoEm       DateTime            @updatedAt
  horarios           Horario[]
  agendamentos       Agendamento[]
  indisponibilidades Indisponibilidade[]
}

model Horario {
  id            String      @id @default(uuid())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  funcionarioId String
  diaSemana     Int // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  startTime     String // Formato HH:mm:ss
  endTime       String // Formato HH:mm:ss
  breakStart    String // Formato HH:mm:ss
  breakEnd      String // Formato HH:mm:ss
}

model Agendamento {
  id            String            @id @default(uuid())
  funcionario   Funcionario       @relation(fields: [funcionarioId], references: [id])
  funcionarioId String
  protocolo     Protocolo         @relation(fields: [protocoloId], references: [id])
  protocoloId   String
  dataHora      DateTime
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt
  status        StatusAgendamento @default(AGENDADO)

  @@unique([funcionarioId, dataHora]) // Garantindo funcionários diferentes tenham agendamentos no mesmo horário
}

model Cliente {
  id           String      @id @default(uuid())
  nome         String
  telefone     String
  email        String      @unique
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  protocolos   Protocolo[]
}

model Protocolo {
  id           String        @id @default(uuid())
  cliente      Cliente       @relation(fields: [clienteId], references: [id])
  clienteId    String
  codigo       String        @unique
  agendamentos Agendamento[]
}

model Indisponibilidade {
  id            String      @id @default(uuid())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  funcionarioId String
  inicio        String // Formato HH:mm:ss
  fim           String // Formato HH:mm:ss
  dataInicio    DateTime? // Opcional, caso queira definir um período específico
  dataFim       DateTime? // Opcional, para definir até quando a regra vale
  motivo        String?
}

model InvalidToken {
  id       String   @id @default(uuid())
  token    String   @unique
  criadoEm DateTime @default(now())
}

enum StatusAgendamento {
  AGENDADO
  CANCELADO
  NAO_COMPARECEU
  ENCERRADO
  EMITIDO
  REAGENDADO
  REAGENDAR
}
